@startuml
title Activity Diagram - Smart Urban Parking Management System

skinparam backgroundColor white
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}
skinparam partition {
  BorderColor #64748B
  FontColor #0F172A
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #FB923C
}

start

partition "مدیر پارکینگ" {
  :ورود به سامانه;
  if (حساب کاربری معتبر است؟) then (بله)
    :انتخاب «ثبت پارکینگ»;
    :ثبت نام پارکینگ;
    :ثبت آدرس و موقعیت مکانی;
    :ثبت ظرفیت پارکینگ;
    :ثبت تعرفه‌ها;
    :ثبت اطلاعات تکمیلی;
    :ارسال درخواست ثبت پارکینگ;
  else (خیر)
    :نمایش خطای ورود;
    stop
  endif
}

partition "سامانه" {
  :اعتبارسنجی اطلاعات اولیه;
  if (اطلاعات کامل و معتبر است؟) then (بله)
    :ایجاد درخواست در وضعیت «در انتظار بررسی»;
    :ارسال اعلان برای اپراتور;
  else (خیر)
    :نمایش خطا و موارد ناقص;
    partition "مدیر پارکینگ" {
      :اصلاح اطلاعات;
      :ارسال مجدد درخواست;
    }
    partition "سامانه" {
      :اعتبارسنجی مجدد;
      :ایجاد درخواست در وضعیت «در انتظار بررسی»;
      :ارسال اعلان برای اپراتور;
    }
  endif
}

partition "اپراتور پارکینگ / بررسی‌کننده" {
  :مشاهده درخواست‌های ثبت پارکینگ;
  :بررسی مشخصات پارکینگ;
  :بررسی آدرس و موقعیت;
  :بررسی ظرفیت و تعرفه;
  :بررسی مدارک و اطلاعات ارائه‌شده;

  if (اطلاعات قابل تأیید است؟) then (بله)
    :تأیید درخواست ثبت پارکینگ;
  else (خیر)
    :رد یا بازگرداندن درخواست برای اصلاح;
    :ثبت دلیل رد/اصلاح;
  endif
}

if (درخواست تأیید شد؟) then (بله)
  partition "سامانه" {
    :تغییر وضعیت پارکینگ به «فعال»;
    :ثبت پارکینگ در فهرست پارکینگ‌های سامانه;
    :به‌روزرسانی ظرفیت و تعرفه;
    :ارسال اعلان تأیید به مدیر پارکینگ;
  }

  partition "مدیر پارکینگ" {
    :مشاهده پارکینگ تأییدشده;
    :مدیریت ظرفیت و جایگاه‌ها;
    :مدیریت تعرفه‌ها;
    :مشاهده و مدیریت رزروها;
  }
else (خیر)
  partition "سامانه" {
    :تغییر وضعیت به «نیازمند اصلاح» یا «رد شده»;
    :ارسال دلیل و نتیجه بررسی به مدیر پارکینگ;
  }

  partition "مدیر پارکینگ" {
    :مشاهده نتیجه بررسی;
    if (نیاز به اصلاح است؟) then (بله)
      :اصلاح اطلاعات پارکینگ;
      :ارسال مجدد درخواست;
    else (خیر)
      :پایان فرایند ثبت;
    endif
  }

  if (درخواست مجدداً ارسال شد؟) then (بله)
    partition "سامانه" {
      :اعتبارسنجی درخواست اصلاح‌شده;
      :ارسال مجدد برای بررسی;
    }
    partition "اپراتور پارکینگ / بررسی‌کننده" {
      :بررسی مجدد درخواست;
      if (تأیید شد؟) then (بله)
        :تأیید درخواست;
      else (خیر)
        :ثبت رد نهایی;
      endif
    }
    partition "سامانه" {
      if (تأیید نهایی است؟) then (بله)
        :فعال‌سازی پارکینگ;
        :اعلان تأیید;
      else (خیر)
        :ثبت وضعیت رد شده;
        :اعلان رد نهایی;
      endif
    }
  endif
endif

partition "راننده" {
  :ورود به بخش جست‌وجوی پارکینگ;
  :جست‌وجو بر اساس موقعیت، نام یا هزینه;
}

partition "سامانه" {
  :نمایش پارکینگ‌های فعال;
  :نمایش ظرفیت و تعرفه;
}

partition "راننده" {
  :انتخاب پارکینگ;
  if (ظرفیت موجود است؟) then (بله)
    :انتخاب زمان;
    :ثبت رزرو;
  else (خیر)
    :انتخاب پارکینگ دیگر;
  endif
}

partition "سامانه" {
  :اعتبارسنجی رزرو;
  if (رزرو مجاز است؟) then (بله)
    :ثبت رزرو;
    :کاهش ظرفیت قابل رزرو;
    :نمایش تأیید رزرو;
  else (خیر)
    :نمایش خطای رزرو;
  endif
}

partition "مدیر/اپراتور پارکینگ" {
  :ثبت ورود خودرو;
  :ثبت زمان ورود و مشخصات خودرو;
}

partition "سامانه" {
  :به‌روزرسانی ظرفیت اشغال‌شده;
  :به‌روزرسانی ظرفیت خالی;
}

partition "مدیر/اپراتور پارکینگ" {
  :ثبت خروج خودرو;
}

partition "سامانه" {
  :محاسبه مدت توقف;
  :محاسبه هزینه نهایی;
  :به‌روزرسانی ظرفیت پارکینگ;
  :ثبت سوابق ورود و خروج;
}

partition "راننده" {
  :پرداخت هزینه;
}

partition "درگاه پرداخت" {
  :پردازش تراکنش;
  if (پرداخت موفق است؟) then (بله)
    :ارسال نتیجه موفق;
  else (خیر)
    :ارسال نتیجه ناموفق;
  endif
}

partition "سامانه" {
  if (پرداخت موفق است؟) then (بله)
    :ثبت پرداخت;
    :صدور رسید;
    :نمایش رسید به راننده;
  else (خیر)
    :نمایش خطای پرداخت;
  endif
}

stop
@enduml
